# Clés du compte PAPER Alpaca (https://app.alpaca.markets > Paper Trading > API Keys)
# Copie ce fichier en .env et remplis-le. Ne commite jamais .env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Doit rester à true tant qu'on n'a pas validé les critères de passage au réel.
ALPACA_PAPER_TRADE=true

# Clé API Anthropic pour l agent analyste (https://console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Modèle de l analyste (optionnel)
# TRADING_ANALYST_MODEL=claude-opus-5-5
